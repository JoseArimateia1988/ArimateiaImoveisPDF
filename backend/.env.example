ANTHROPIC_API_KEY=sk-ant-...
PORT=3001
NODE_ENV=production

# Banco principal do produto. Use PostgreSQL OU D1.
# Opção A: PostgreSQL
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# Opção B: Cloudflare D1 via API oficial
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=

# Somente para homologação com o corretor piloto.
# O produto comercial deve usar a integração oficial/OAuth da Órulo.
ORULO_SHARE_LINKS_ENABLED=false

# Compatibilidade temporária com apresentações do banco antigo.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# URL pública do produto — usada nos links enviados por e-mail (redefinir senha etc.)
APP_URL=https://busca.moodlabs.com.br

# E-mail transacional (Resend) — redefinição de senha
RESEND_API_KEY=
EMAIL_FROM=Busca Certa <onboarding@resend.dev>

# Mercado Pago — aplicação MoodLabs | Assinaturas
MERCADOPAGO_APPLICATION_ID=2010441633420546
MERCADOPAGO_ACCESS_TOKEN=
# Developers > Sua aplicação > Webhooks > Assinatura secreta.
# O webhook é recusado quando esta chave não está configurada.
MERCADOPAGO_WEBHOOK_SECRET=

# Painel administrativo protegido (/api/admin/overview)
BUSCA_CERTA_ADMIN_TOKEN=
