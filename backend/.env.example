ANTHROPIC_API_KEY=sk-ant-...
PORT=3001
NODE_ENV=production

# Banco principal do produto. Necessário para contas, perfis, histórico e medição de uso.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# Somente para homologação com o corretor piloto.
# O produto comercial deve usar a integração oficial/OAuth da Órulo.
ORULO_SHARE_LINKS_ENABLED=false

# Compatibilidade temporária com apresentações do banco antigo.
# O novo fluxo de contas não usa Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
