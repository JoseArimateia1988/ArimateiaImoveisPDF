ANTHROPIC_API_KEY=sk-ant-...
PORT=3001

# Banco principal do produto. Preferencialmente Postgres.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# Compatibilidade temporária com o banco antigo, caso ainda exista.
# Se DATABASE_URL estiver configurada, estas variáveis são ignoradas.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
